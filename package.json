{
  "name": "kurotv-s",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run build --workspace=packages/sync-client",
    "build:client": "vite build --config vite.client.config.ts && npm run build --workspace=packages/sync-client",
    "build:server": "vite build --config vite.server.config.ts",
    "build:docker": "npm run build:client && npm run build:server",
    "start:docker": "node dist/server/index.mjs",
    "deploy": "npx wrangler d1 migrations apply DB --remote && npx wrangler deploy",
    "test": "vitest run",
    "test:workers": "vitest run --project workers",
    "test:client": "vitest run --project client-sdk",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && npm run typecheck --workspace=packages/sync-client",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.18",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vitest": "4.1.12",
    "wrangler": "^4.160.1"
  }
}
