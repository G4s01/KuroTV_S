# ==============================================================================
# KuroTV_S Self-Hosted Docker Configuration (.env.example)
# Copia questo file in `.env` prima di avviare `docker compose up -d`
# ==============================================================================

# Directory esterna sull'host dove salvare il database SQLite (kurosync.db)
KUROSYNC_DATA_DIR=./data

# Modalità montaggio volume dati: 'rw' (normale lettura/scrittura) oppure 'ro' (sola lettura)
KUROSYNC_DATA_MODE=rw

# Imposta a 'true' per avviare il database SQLite in modalità sola lettura
KUROSYNC_READ_ONLY=false

# UID/GID e UMASK del processo container (usa `id -u` e `id -g` sul tuo host Linux)
# Esempi UMASK: 022 (default: file 644 / dir 755), 002 (gruppo scrivibile: file 664), 077 (privato: file 600)
PUID=1000
PGID=1000
UMASK=022

# Porta esposta e di ascolto del server (usata sia in bridge mode che in host mode)
KUROSYNC_PORT=8787

# Indirizzo bind host in bridge mode (usa 0.0.0.0 per LAN/NPM in bridge, 127.0.0.1 se NPM è in host mode sullo stesso server)
KUROSYNC_BIND_ADDRESS=0.0.0.0

# Imposta a 'true' quando KuroTV_S è dietro un reverse proxy (es. Nginx Proxy Manager)
TRUST_PROXY=true

# Opzionale: URL pubblico completo servito da NPM (es. https://kurosync.tuodominio.it)
# Se vuoto, viene dedotto automaticamente dagli header X-Forwarded-Proto/Host di NPM
PUBLIC_URL=

# Opzionale: se impostato, bypassa il Setup Wizard e blocca la Master Password su questo valore
SYNC_ADMIN_SECRET=

# Opzionale (emergenza): se impostato, aggiorna la Master Password nel DB all'avvio (idempotente; rimuovere dopo l'uso)
KUROSYNC_RESET_PASSWORD=

# Limite massimo payload JSON per push/import backup in byte (default 50 MB)
MAX_BODY_BYTES=52428800
