{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurotv-s",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kurosync-db",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
